<?xml version="1.0" encoding="UTF-8"?>
<!--
  Security guard desktop application (Java Swing). A separate program with its own main():
      java -jar gatepass-guard.jar
  It uses the SAME gatepass-core classes and the SAME gatepass.db file as the website.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gatepass</groupId>
        <artifactId>gatepass-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>gatepass-guard</artifactId>
    <packaging>jar</packaging>
    <name>Gate Pass Guard App (Swing)</name>

    <dependencies>
        <dependency>
            <groupId>com.gatepass</groupId>
            <artifactId>gatepass-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>gatepass-guard</finalName>
        <plugins>
            <!-- Makes "java -jar gatepass-guard.jar" work: main class + libraries in lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.gatepass.guard.GuardApp</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <!-- Java 24+: lets the SQLite driver load its native code without a warning -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-libs</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
