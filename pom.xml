<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parent POM for the Digital Gate Pass project (Group 13).
  It fixes ONE set of versions for every module so that web and guard apps stay compatible.

  Modules (added stage by stage):
    gatepass-core   -> shared model, DAO, service, DB, email   (stage 1-8)
    gatepass-web    -> servlets + JSP for student/warden        (stage 9-10)
    gatepass-guard  -> Swing guard desktop app                  (stage 11)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gatepass</groupId>
    <artifactId>gatepass-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Digital Gate Pass &amp; Campus Exit Management System</name>

    <modules>
        <module>gatepass-core</module>
    </modules>

    <properties>
        <!-- Your laptop runs JDK 25, so we compile for Java 25.
             On a machine with an older JDK use:  mvn -Dmaven.compiler.release=21 ...  -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <sqlite.jdbc.version>3.50.3.0</sqlite.jdbc.version>
        <junit.version>5.11.4</junit.version>
        <!-- Web stack (used from stage 9): Tomcat 10.1 = Servlet 6.0 / JSP 3.1 = jakarta.* namespace -->
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
        <jakarta.jsp.version>3.1.1</jakarta.jsp.version>
        <!-- Mail (used from stage 7) -->
        <jakarta.mail.version>2.1.3</jakarta.mail.version>
        <angus.mail.version>2.0.3</angus.mail.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- silences the "restricted method" notice printed by the SQLite driver on Java 24+ -->
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
